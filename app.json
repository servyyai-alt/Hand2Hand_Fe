{
  "expo": {
    "name":   "Hand2Hand Delivery",
    "slug":   "hand2hand-delivery",
    "scheme": "hand2hand",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon":    "./assets/images/icon.png",
    "splash": {
      "image":           "./assets/images/splash.png",
      "resizeMode":      "contain",
      "backgroundColor": "#16a34a"
    },
    "ios":     { "supportsTablet": false, "bundleIdentifier": "in.hand2hand.delivery" },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/images/adaptive-icon.png", "backgroundColor": "#16a34a" },
      "package": "in.hand2hand.delivery",
      "permissions": ["ACCESS_FINE_LOCATION","ACCESS_COARSE_LOCATION","CAMERA","READ_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Allow Hand2Hand to access your location." }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
